{
    "name": "liberusoftware/ecommerce-commerce-core-livewire",
    "description": "Livewire 4 components presenting the stores, channels and commercial context owned by liberusoftware/ecommerce-commerce-core.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-commerce-core"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "liberusoftware/module-manager": "^1.4",
        "liberusoftware/ecommerce-commerce-core": "^0.3"
    },
    "require-dev": {
        "liberusoftware/ecommerce-commerce-core": "^0.3",
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\CommerceCore\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\CommerceCore\\Livewire\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-commerce-core-livewire"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
